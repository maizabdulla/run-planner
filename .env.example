# These are set as SECRETS on Supabase (Edge Functions), not committed to git.
# Set them with:
#   supabase secrets set STRAVA_CLIENT_ID=xxxx STRAVA_CLIENT_SECRET=xxxx
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are already provided automatically
# to Edge Functions by Supabase — you do not need to set those yourself.

STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Added in the security update — set all of these:
#   supabase secrets set OWNER_USER_ID=your-auth-user-uuid
#   supabase secrets set ALLOWED_ORIGIN=https://yourname.github.io
#   supabase secrets set CRON_SECRET=some-long-random-string   (only if using auto-sync)
#
# SUPABASE_ANON_KEY is also needed by the functions to validate caller tokens.
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically,
# but you must set the anon key yourself:
#   supabase secrets set SUPABASE_ANON_KEY=your-anon-public-key

OWNER_USER_ID=your_auth_user_uuid
ALLOWED_ORIGIN=https://yourname.github.io
CRON_SECRET=generate_a_long_random_string
SUPABASE_ANON_KEY=your_anon_public_key
